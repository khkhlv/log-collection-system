            "charts": {
                "CHART-1": {
                    "form_data": {
                        "datasource": "1__table",
                        "viz_type": "line",
                        "slice_id": 1,
                        "metric": {
                            "expressionType": "SIMPLE",
                            "column": {
                                "column_name": "id",
                                "type": "BIGINT"
                            },
                            "aggregate": "COUNT"
                        },
                        "groupby": ["hour_bucket"],
                        "time_range": "Last 24 hours",
                        "row_limit": 1000
                    }
                },
                "CHART-2": {
                    "form_data": {
                        "datasource": "1__table",
                        "viz_type": "pie",
                        "slice_id": 2,
                        "metric": {
                            "expressionType": "SIMPLE",
                            "column": {
                                "column_name": "id",
                                "type": "BIGINT"
                            },
                            "aggregate": "COUNT"
                        },
                        "groupby": ["level"],
                        "row_limit": 10
                    }
                },
                "CHART-3": {
                    "form_data": {
                        "datasource": "1__table",
                        "viz_type": "bar",
                        "slice_id": 3,
                        "metric": {
                            "expressionType": "SIMPLE",
                            "column": {
                                "column_name": "id",
                                "type": "BIGINT"
                            },
                            "aggregate": "COUNT"
                        },
                        "groupby": ["source"],
                        "row_limit": 10,
                        "order_desc": true
                    }
                },
                "CHART-4": {
                    "form_data": {
                        "datasource": "1__table",
                        "viz_type": "bar",
                        "slice_id": 4,
                        "metric": {
                            "expressionType": "SIMPLE",
                            "column": {
                                "column_name": "id",
                                "type": "BIGINT"
                            },
                            "aggregate": "COUNT"
                        },
                        "groupby": ["error_type"],
                        "row_limit": 3,
                        "order_desc": true,
                        "adhoc_filters": [
                            {
                                "clause": "WHERE",
                                "comparator": "ERROR",
                                "expressionType": "SIMPLE",
                                "operator": "IN",
                                "subject": "level"
                            }
                        ]
                    }
                },
                "CHART-5": {
                    "form_data": {
                        "datasource": "1__table",
                        "viz_type": "pivot_table",
                        "slice_id": 5,
                        "metrics": [
                            {
                                "expressionType": "SIMPLE",
                                "column": {
                                    "column_name": "id",
                                    "type": "BIGINT"
                                },
                                "aggregate": "COUNT"
                            }
                        ],
                        "groupby": ["source", "error_type"],
                        "row_limit": 3,
                        "order_desc": true
                    }
                },
                "CHART-6": {
                    "form_data": {
                        "datasource": "1__table",
                        "viz_type": "line",
                        "slice_id": 6,
                        "metric": {
                            "expressionType": "SQL",
                            "sqlExpression": "COUNT(*) FILTER (WHERE level IN ('ERROR', 'CRITICAL')) * 100.0 / NULLIF(COUNT(*), 0)"
                        },
                        "groupby": ["hour_bucket", "source"],
                        "time_range": "Last 48 hours",
                        "row_limit": 1000
                    }
                },
                "CHART-7": {
                    "form_data": {
                        "datasource": "1__table",
                        "viz_type": "table",
                        "slice_id": 7,
                        "columns": ["source", "last_log_time", "hours_since_last_log", "status"],
                        "metrics": [],
                        "groupby": ["source"],
                        "row_limit": 20,
                        "adhoc_filters": [
                            {
                                "clause": "HAVING",
                                "comparator": "1",
                                "expressionType": "SIMPLE",
                                "operator": ">",
                                "subject": "hours_since_last_log"
                            }
                        ]
                    }
                }
            },
            "uuid": "log-dashboard-001"
        }
    ],
